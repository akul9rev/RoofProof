# RoofProof Backend Environment Configuration

PORT=3001

# Cloudinary CDN Credentials (Get free API key at https://cloudinary.com)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Alternatively configure via single connection URL string:
# CLOUDINARY_URL=cloudinary://YOUR_API_KEY:YOUR_API_SECRET@YOUR_CLOUD_NAME

# Midnight Testnet / Devnet Configuration
MIDNIGHT_CONTRACT_ADDRESS=0x9f8f72aa9304f8b9e6717a61d152a514d8641b6c
MIDNIGHT_MNEMONIC="kit rigid asset author marriage assume illegal wolf doll metal auction beyond bus sad deposit benefit shell danger orient jump slim spoon hint merge"
